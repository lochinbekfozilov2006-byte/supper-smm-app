{
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/e/:file", "destination": "/:file" }
  ],
  "headers": [
    { "source": "/e/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
  ]
}
